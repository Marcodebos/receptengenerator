# ============================================
# RECEPTEN GENERATOR — Omgevingsvariabelen
# ============================================
# Kopieer dit bestand naar .env.local en vul je API keys in.
# .env.local wordt NOOIT gecommit naar Git.

# Claude API key — voor receptgeneratie
# Aanmaken via: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI API key — voor afbeeldingsgeneratie (DALL-E 3)
# Aanmaken via: https://platform.openai.com/api-keys
# Optioneel: zonder deze key worden geen afbeeldingen gegenereerd
OPENAI_API_KEY=sk-...
